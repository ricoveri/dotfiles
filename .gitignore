# Dotfiles repo: deny by default, then un-ignore only what you version.
# Finer rules live in subtree .gitignore files (e.g. .zsh/profile.d/, .config/karabiner/).

# --- deny everything ---
*

# --- repo meta ---
!.gitignore
!.gitconfig
!README.md

# --- zsh (narrow: only profile.d/ and custom/) ---
!.zshrc
!.zshenv
!.zsh/
!.zsh/profile.d/
!.zsh/profile.d/**
!.zsh/custom/
!.zsh/custom/**

# --- tmux ---
!.tmux.conf
!.tmux/
!.tmux/conf.d/
!.tmux/conf.d/**

# --- Karabiner-Elements ---
!.config/
!.config/karabiner/
!.config/karabiner/**

# --- .local (only dotenv helper + crate) ---
!.local/
!.local/bin/
!.local/bin/dotenv.py
!.local/bin/dotenv/
!.local/bin/dotenv/**

# --- editor / OS cruft (under allowlisted trees) ---
*.swp
**/.DS_Store
