# Dotfiles repo: deny by default, then un-ignore only what you version.
# Finer rules live in subtree .gitignore files (e.g. .zsh/profile.d/, .config/karabiner/).

# --- deny everything ---
*

# --- repo meta ---
!.gitignore
!.gitconfig
!README.md
!AGENTS.md
!CLAUDE.md
!.gitleaks.toml
!.githooks/
!.githooks/**

# --- zsh (narrow: only profile.d/ and custom/) ---
!.zshrc
!.zshenv
!.zsh/
!.zsh/profile.d/
!.zsh/profile.d/**
!.zsh/custom/
!.zsh/custom/**

# --- tmux ---
!.tmux.conf
!.tmux/
!.tmux/conf.d/
!.tmux/conf.d/**

# --- envy drop-ins (non-sensitive only; secrets live in ~/.dotsync) ---
!.envy.d/
!.envy.d/00-essentials.yaml
!.envy.d/00-macos.yaml
!.envy.d/99-path.yaml

# --- Karabiner-Elements ---
!.config/
!.config/karabiner/
!.config/karabiner/**

# --- herdr (config only; dir also holds sockets, logs, session state) ---
!.config/herdr/
!.config/herdr/config.toml
!.config/herdr/plugins.list

# --- herdr-app (own layout, keys and mods only; shipped files, .d.ts, state and sockets stay untracked) ---
!.config/herdr-app/
!.config/herdr-app/keys.json
!.config/herdr-app/layouts/
!.config/herdr-app/layouts/main-pr.json
!.config/herdr-app/layouts/cyberpunk.json
!.config/herdr-app/themes/
!.config/herdr-app/themes/cyberpunk.json
!.config/herdr-app/fonts/
!.config/herdr-app/fonts/TerminessNerdFontMono-Regular.ttf
!.config/herdr-app/fonts/TerminessNerdFontMono-Bold.ttf
!.config/herdr-app/fonts/TerminessNerdFontMono-Italic.ttf
!.config/herdr-app/fonts/TerminessNerdFontMono-BoldItalic.ttf
!.config/herdr-app/fonts/LICENSE-Terminus.txt
!.config/herdr-app/mods/
!.config/herdr-app/mods/pr/
!.config/herdr-app/mods/pr/main.js
!.config/herdr-app/mods/pr/mod.json
!.config/herdr-app/mods/leader/
!.config/herdr-app/mods/leader/main.js
!.config/herdr-app/mods/leader/mod.json
!.config/herdr-app/mods/which-key/
!.config/herdr-app/mods/which-key/main.js
!.config/herdr-app/mods/which-key/mod.json
!.config/herdr-app/mods/palette/
!.config/herdr-app/mods/palette/main.js
!.config/herdr-app/mods/palette/mod.json
!.config/herdr-app/mods/switch-palette/
!.config/herdr-app/mods/switch-palette/main.js
!.config/herdr-app/mods/switch-palette/mod.json
!.config/herdr-app/mods/agent-select/
!.config/herdr-app/mods/agent-select/main.js
!.config/herdr-app/mods/agent-select/mod.json
!.config/herdr-app/mods/worktree-hooks/
!.config/herdr-app/mods/worktree-hooks/main.js
!.config/herdr-app/mods/worktree-hooks/mod.json
!.config/herdr-app/mods/worktree-hooks/hooks.js
!.config/herdr-app/mods/worktree-hooks/yaml.js
!.config/herdr-app/mods/menu-hooks/
!.config/herdr-app/mods/menu-hooks/main.js
!.config/herdr-app/mods/menu-hooks/mod.json
!.config/herdr-app/mods/new-menu-hooks/
!.config/herdr-app/mods/new-menu-hooks/main.js
!.config/herdr-app/mods/new-menu-hooks/mod.json
!.config/herdr-app/mods/tabs-hooks/
!.config/herdr-app/mods/tabs-hooks/main.js
!.config/herdr-app/mods/tabs-hooks/mod.json
!.config/herdr-app/mods/tabs-hooks/win-close.svg
!.config/herdr-app/mods/tabs-hooks/win-max.svg
!.config/herdr-app/mods/tabs-hooks/win-min.svg
!.config/herdr-app/mods/tabs-hooks/win-restore.svg
!.config/herdr-app/mods/spaces-hooks/
!.config/herdr-app/mods/spaces-hooks/main.js
!.config/herdr-app/mods/spaces-hooks/mod.json
!.config/herdr-app/mods/term-copy/
!.config/herdr-app/mods/term-copy/main.js
!.config/herdr-app/mods/term-copy/mod.json
.config/herdr-app/AGENTS.md

# --- Claude Code (portable config only; state and credentials stay untracked) ---
!.claude/
!.claude/keybindings.json
!.claude/statusline.sh
!.claude/settings.json.macos
!.claude/settings.json.linux
!.claude/commands/
!.claude/commands/doc.md
!.claude/commands/git-commit-and-push.md
!.claude/skills/
!.claude/skills/dotfiles-autocommit/
!.claude/skills/dotfiles-autocommit/**

# --- foot terminal (config only) ---
!.config/foot/
!.config/foot/foot.ini

# --- ghostty terminal (platform link is generated, track only the variants) ---
!.config/ghostty/
!.config/ghostty/config
!.config/ghostty/platform.linux
!.config/ghostty/platform.macos

# --- Hyprland / Omarchy (key bindings only) ---
!.config/hypr/
!.config/hypr/bindings.lua
!.config/hypr/hyprland.lua
!.config/hypr/input.lua

# --- .local (bootstrap script) ---
!.local/
!.local/bin/
!.local/bin/dot-bootstrap
!.local/bin/herdr-plugins-sync

# --- editor / OS cruft (under allowlisted trees) ---
*.swp
**/.DS_Store
