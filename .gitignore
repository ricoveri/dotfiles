# Dotfiles repo: deny by default, then un-ignore only what you version.
# Finer rules live in subtree .gitignore files (e.g. .zsh/profile.d/, .config/karabiner/).

# --- deny everything ---
*

# --- repo meta ---
!.gitignore
!.gitconfig
!README.md
!AGENTS.md
!CLAUDE.md

# --- zsh (narrow: only profile.d/ and custom/) ---
!.zshrc
!.zshenv
!.zsh/
!.zsh/profile.d/
!.zsh/profile.d/**
!.zsh/custom/
!.zsh/custom/**

# --- tmux ---
!.tmux.conf
!.tmux/
!.tmux/conf.d/
!.tmux/conf.d/**

# --- envy drop-ins (non-sensitive only; secrets live in ~/.dotsync) ---
!.envy.d/
!.envy.d/00-essentials.yaml
!.envy.d/00-macos.yaml
!.envy.d/99-path.yaml

# --- Karabiner-Elements ---
!.config/
!.config/karabiner/
!.config/karabiner/**

# --- herdr (config only; dir also holds sockets, logs, session state) ---
!.config/herdr/
!.config/herdr/config.toml
!.config/herdr/plugins.list

# --- Claude Code (portable config only; state and credentials stay untracked) ---
!.claude/
!.claude/keybindings.json
!.claude/statusline.sh
!.claude/settings.json.macos
!.claude/settings.json.linux
!.claude/commands/
!.claude/commands/doc.md
!.claude/commands/git-commit-and-push.md
!.claude/skills/
!.claude/skills/dotfiles-autocommit/
!.claude/skills/dotfiles-autocommit/**

# --- foot terminal (config only) ---
!.config/foot/
!.config/foot/foot.ini

# --- ghostty terminal (platform link is generated, track only the variants) ---
!.config/ghostty/
!.config/ghostty/config
!.config/ghostty/platform.linux
!.config/ghostty/platform.macos

# --- Hyprland / Omarchy (key bindings only) ---
!.config/hypr/
!.config/hypr/bindings.lua
!.config/hypr/input.lua

# --- .local (bootstrap script) ---
!.local/
!.local/bin/
!.local/bin/dot-bootstrap
!.local/bin/herdr-plugins-sync

# --- editor / OS cruft (under allowlisted trees) ---
*.swp
**/.DS_Store
