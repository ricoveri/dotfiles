#!/usr/bin/env bash
##################################################################
# herdr-plugins-sync: install the herdr plugins listed in
# ~/.config/herdr/plugins.list when they are missing
# Idempotent: safe to re-run; called by dot-bootstrap and zsh init
##################################################################

set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

herdr_dir="$HOME/.config/herdr"
list="$herdr_dir/plugins.list"
lock="$herdr_dir/.plugins-sync.lock"

command -v herdr > /dev/null 2>&1 || exit 0
[ -f "$list" ] || exit 0

# Concurrent shells must not race on the same install
mkdir "$lock" 2> /dev/null || exit 0
trap 'rmdir "$lock"' EXIT

failed=0
while read -r entry; do
    case "$entry" in ''|'#'*) continue ;; esac

    # Installs land in plugins/github/<repo>-<hash>/ or, depending on the
    # herdr version, plugins/github-installations/<repo>-<hash>/
    repo="${entry#*/}"
    repo="${repo%%/*}"
    if compgen -G "$herdr_dir/plugins/github*/$repo-*/" > /dev/null; then
        continue
    fi

    # The flag must follow the positional; stdin is the list being read
    log "installing herdr plugin $entry"
    herdr plugin install "$entry" --yes < /dev/null || { log "failed: $entry"; failed=1; }
done < "$list"

exit "$failed"
